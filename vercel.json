{
  "crons": [
    {
      "path": "/api/cron/rappels",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "semou-group.vercel.app"
        }
      ],
      "destination": "https://www.semougroupe.sn/:path*",
      "permanent": true
    }
  ]
}
